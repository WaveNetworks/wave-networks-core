# wave-networks-core .htaccess
# Security & Routing

# Custom error pages — logged to DB for security monitoring
ErrorDocument 403 /admin/error.php
ErrorDocument 404 /admin/error.php
ErrorDocument 500 /admin/error.php

# Deny direct web access to sensitive folders via rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On

    # /admin/ directory index (and explicit /admin/index.php) → redirect to login
    RewriteRule ^(index\.php)?$ /admin/auth/login.php?to=admin [R=302,L]

    # Friendly login URL aliases → redirect to the real login page
    # Catches /admin/login, /admin/login/, /admin/signin, /admin/sign-in (case-insensitive)
    RewriteRule ^(login|signin|sign-in)/?$ /admin/auth/login.php [R=302,L,NC]

    # Block access to sensitive directories
    RewriteRule ^(vendor|db_migrations|cron|tests|include|config|views|snippets|docker)(/|$) - [F,L]

    # Serve branding assets from files directory via branding.php proxy
    RewriteRule ^branding/(.+)$ branding.php?f=$1 [L,QSA]

    # Serve media-library assets from files directory via media.php proxy
    RewriteRule ^media/(.+)$ media.php?f=$1 [L,QSA]

    # Serve onboarding tour media (uploaded welcome videos) via tour_media.php proxy
    RewriteRule ^tour_media/(.+)$ tour_media.php?f=$1 [L,QSA]

    # Public legal documents (legal.php): /admin/legal/privacy, /admin/legal/terms and a
    # permalink per version, /admin/legal/privacy/v/2.0
    RewriteRule ^legal/(privacy|terms)/?$ legal.php?doc=$1 [L,QSA]
    RewriteRule ^legal/(privacy|terms)/v/([0-9][0-9A-Za-z.\-]{0,31})/?$ legal.php?doc=$1&v=$2 [L,QSA]

    # Serve admin feedback screenshots (admin-only auth in PHP)
    RewriteRule ^feedback/screenshot/([0-9]+)$ feedback_screenshot.php?id=$1 [L,QSA]

    # Pretty URLs (optional - index.php handles routing)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
</IfModule>

# Deny access to hidden files (.env, .git, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Deny access to composer files
<FilesMatch "^(composer\.(json|lock)|package\.json|package-lock\.json|deploy\.py|deploy_config\.py|deploy_config\.sample\.py|Dockerfile|docker-compose.*\.yml|CLAUDE\.md|CHILD_APP_SPEC\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
